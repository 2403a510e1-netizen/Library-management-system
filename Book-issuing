
from database import create_tables, connect_db
from datetime import date

create_tables()

print("\n--- FINE CALCULATION ---")

student_id = input("Enter Student ID: ")
book_id = input("Enter Book ID: ")

con = connect_db()
cur = con.cursor()

cur.execute("""
SELECT issue_id, due_date, return_date
FROM issues
WHERE student_id = ? AND book_id = ?
ORDER BY issue_id DESC LIMIT 1
""", (student_id, book_id))

record = cur.fetchone()

if record:
    issue_id, due_date, return_date = record

    if return_date:
        actual_date = date.fromisoformat(return_date)
    else:
        actual_date = date.today()

    due = date.fromisoformat(due_date)
    overdue_days = max(0, (actual_date - due).days)

    fine = overdue_days * 5

    cur.execute("""
    UPDATE issues SET fine = ?
    WHERE issue_id = ?
    """, (fine, issue_id))

    con.commit()

    print("Overdue Days:", overdue_days)
    print("Fine Amount: Rs.", fine)

else:
    print("Issue record not found!")

con.close()
