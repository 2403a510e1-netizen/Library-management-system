
from database import create_tables, connect_db

create_tables()

print("\n--- BOOK SEARCHING ---")

search = input("Enter Book ID or Book Name: ")

con = connect_db()
cur = con.cursor()

cur.execute("""
SELECT * FROM books
WHERE book_id = ? OR book_name LIKE ?
""", (search, "%" + search + "%"))

books = cur.fetchall()

if books:
    for book in books:
        print("\nBook ID:", book[0])
        print("Book Name:", book[1])
        print("Author:", book[2])
        print("Publisher:", book[3])
        print("Available Quantity:", book[4])
else:
    print("Book not found!")

con.close()
