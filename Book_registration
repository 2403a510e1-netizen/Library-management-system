
# Book Registration Module

books = []

def register_book():
    book_id = input("Enter Book ID: ")
    book_name = input("Enter Book Name: ")
    author = input("Enter Author Name: ")
    quantity = int(input("Enter Quantity: "))

    book = {
        "id": book_id,
        "name": book_name,
        "author": author,
        "quantity": quantity
    }

    books.append(book)

    print("Book registered successfully!")

register_book()
